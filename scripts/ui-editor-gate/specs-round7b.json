{
 "version": 1,
 "vocabulary": {
  "steps": {
   "pickerFire": "Round 7b (my definition): find the colour input next to the menu button `button` (input[type=color][data-picker=<button>]); set its value to `value`; fire `inputs` bubbling `input` events; then, if `change`, one `change` event; if `blur`, a `blur` and a `focusout` event (a cancelled picker: the browser's popup cannot be driven by a script, so what the page does with the input's events is what is checked).",
   "snapshotStorage": "store localStorage, sessionStorage and document.cookie under `name`.",
   "focusMenuItem": "script-focus the item named `name` of the open menu (then the key steps follow).",
   "button": "as before: click the button named `name`.",
   "type": "as before (round 6): `field` is the hex box's field (Text colour, Background, Border colour), `text` what is typed, then Enter.",
   "openMenu/menuItem/key/focusControl/host/load/click": "as before."
  },
  "asserts": {
   "colourGrid": "P1. The open menu `button` has a group named `Colour grid` with `values.length` items (role menuitemradio) in this order, each named `Grid <hex>` and drawn in that colour (the swatch's background colour as six-digit hex); no two have the same name; at the wide width (`columns`, `rows`, `cell` given): `rows` rows and `columns` columns (tops and lefts grouped within 4 px), `columns` cells in every row, reading order left to right then down, every cell `cell` px square within 1 px.",
   "menuOrder": "P5. The names of the open menu's direct children (groups by aria-label, items by name), hidden ones left out, equal `order`.",
   "recentList": "P5. The `Recent colours` group of the open menu holds exactly the items `Recent <hex>` for `want`, in order (an empty `want` means there is no such group).",
   "gridChecked": "P5. The cells of the Colour grid with aria-checked true are exactly `Grid <hex>` for `want`.",
   "exportsEqualSub": "P2. For every exported file, the text stored under `a` with every `from` replaced by `to` equals the text stored under `b` (the same property and value a Standard swatch writes), and `a` contains `from` somewhere.",
   "storageSame": "P5. localStorage, sessionStorage and document.cookie equal the snapshot `name`.",
   "editCount": "P5. The tool's read-only attribute data-edit-list holds `n` edits.",
   "otherMenusLackGrid": "P5. Every other visible, enabled menu button (not in `except`, at least three of them) is opened and has no group named Colour grid or Recent colours and no item named Pick any colour\u2026 (then Escape).",
   "noGridIn": "P5. The open menus named in `menus` (the Gradient From and To colour submenus) have no group named Colour grid or Recent colours.",
   "menuTouch": "P1 (my definition). Every item (role menuitem or menuitemradio) of the open menu `button` is at least `min` px high and wide (0.5 px), the menu lies inside the window (or scrolls inside it), is not clipped sideways, has grid cells and a Pick item, and with `recents` also recent colours.",
   "uniqueMenuNames": "P5 (my definition). Every name of the new items (Grid <hex>, Recent <hex>, Pick any colour\u2026) occurs once among the open menu's items, and no item lacks a name (the page colours and the standard colours already repeat a colour that both hold; that is not counted).",
   "pickerPresent": "P5. There is exactly one colour input next to the menu button `button` (so it is still mounted when the menu has closed).",
   "menuState/menuFits/focusOn/css/exportEqualsOriginal": "as before."
  }
 },
