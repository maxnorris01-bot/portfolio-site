{
 "version": 1,
 "note": "UI Editor scroll fix 2: the per-frame re-measure, in Chromium and WebKit. M01 to M09; the prefix M is used by no earlier spec file. Independent checks: real boxes, counters made from the host window; never the page's own state. Run with --browser webkit for the WebKit cases (M01 to M08).",
 "hostViewport": {
  "width": 1920,
  "height": 1080
 },
 "previewHeight": 800,
 "outcomes": [
  "PASS",
  "FAIL"
 ],
 "vocabulary": {
  "note": "as specs-scrollfix.json, plus: step wheelBurst {n, dy, gap} (n real wheel steps over the preview, gap ms apart, while the page samples the outline and the element every animation frame), step wait {ms}, step resetCounters (frame callbacks requested by the page, measures of the preview's elements, changes of the overlay), step tabHidden {hidden} (the page's visibility state), step navigate {link} (follow a link of the site's nav); assert outlineLag {sel, tol, maxLagFrames} (every sampled frame's outline equals the element's box of that frame or of the frame before, and the last frames equal the element's), assert outlineStays {sel, ms, every, tol}, assert counters {rafPerSecMin, rafPerSecMax, overlayMutations, gbcrPerSecMax, pendingMax} since the last resetCounters. See docs/ui-editor-gate-rules-scrollfix2.md section 4."
 },
 "specs": [
  {
   "id": "M01",
   "name": "Many small wheel steps (16 of 14 px, a trackpad's burst) over the Phone preview: the outline matches the element's box of the same frame or of the frame before (1 px) at every frame while the content moves, and within 1 px by the next frame after it stops; for the headline and a lower element; then it stays within 1 px for 1 s",
   "sample": "landing",
   "checks": [
    "P1"
   ],
   "expected": "PASS",
   "steps": [
    {
     "do": "load",
     "sample": "landing"
    },
    {
     "do": "view",
     "name": "Phone"
    },
    {
     "do": "click",
     "sel": "#headline",
     "at": "center"
    },
    {
     "do": "scrollPreview",
     "how": "scrollTo",
     "y": 0
    },
    {
     "do": "wheelBurst",
     "n": 16,
     "dy": 14,
     "gap": 16
    },
    {
     "do": "assert",
     "p": "P1",
     "k": "outlineLag",
     "sel": "#headline",
     "tol": 1,
     "maxLagFrames": 1
    },
    {
     "do": "assert",
     "p": "P1",
     "k": "outlineFollows",
     "sel": "#headline",
     "tol": 1
    },
    {
     "do": "assert",
     "p": "P1",
     "k": "outlineStays",
     "sel": "#headline",
     "ms": 1000,
     "every": 100,
     "tol": 1
    },
    {
     "do": "click",
     "sel": "#card-plan h3",
     "at": "center"
    },
    {
     "do": "scrollPreview",
     "how": "scrollTo",
     "y": 0
    },
    {
     "do": "wheelBurst",
     "n": 16,
     "dy": 14,
     "gap": 16
    },
    {
     "do": "assert",
     "p": "P1",
     "k": "outlineLag",
     "sel": "#card-plan h3",
     "tol": 1,
     "maxLagFrames": 1
    },
    {
     "do": "assert",
     "p": "P1",
     "k": "outlineFollows",
     "sel": "#card-plan h3",
     "tol": 1
    },
    {
     "do": "assert",
     "p": "P1",
     "k": "outlineStays",
     "sel": "#card-plan h3",
     "ms": 1000,
     "every": 100,
     "tol": 1
    }
   ]
