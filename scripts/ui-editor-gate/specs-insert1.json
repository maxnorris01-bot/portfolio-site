  "steps": {
   "placeCases": "For each case {kind, sel, zone, parent, index, tag, keep?}: openMenu Insert, menuItem kind; hoverElement sel at zone (before: the point 8% down the element's box, after: 92%, inside: 50%, horizontally centred); assert insertLine active with zone and geometry within lineTol of the stated edge (before: the line's centre within lineTol of the box's top edge; after: of the bottom edge; inside: the line's box within lineTol of the element's box); click that point; assert the new element is selected (its class starts new-box, new-text or new-button), its DOM position (parent selector, index among the parent's element children, tag) and that its preview box equals its box in the exported file loaded fresh within 1 px; assert the export equals the engine's own result for the same edit (the vendored engine applied to the original with the same one edit); then, unless keep, Undo and assert the export equals the original bytes.",
   "hoverElement": "move the mouse over the stated zone of the element sel in the preview (window points; no click).",
   "dblclickElement": "double-click the centre of sel in the preview.",
   "fillText": "replace the whole text of the focused-by-script field target (textEditor: the overlay text box; commentBox: the comment popover's text area) with `text` using keyboard events (select all, then type); an empty `text` clears it.",
   "setLink": "set the Link checkbox to `checked`.",
   "clickButton": "click the visible button whose accessible name is `name` (a Save inside a popover is found within the open popover).",
   "confirm": "click the confirm button named `name` in the confirmation line.",
   "pressPage": "focus the preview area (not a field) and press `key`.",
   "focusField": "focus the ribbon field named `name`.",
   "selectPath": "click the segment named `name` in the selection path.",
   "clickPin": "click the pin numbered n.",
   "clickNotesRow": "in the open Notes list: row n's `action` (jump: the row's label button; Edit; Delete) or the page row's action (Add a note for the whole page; Delete page note).",
   "snapshotCopy": "click Copy code and store the copied text of every file under `name`.",
   "setBox": "set the checkbox named `name` to `checked` by clicking it when it differs.",
   "noteEach": "for each target (selector, in order) select it and give it the next text through the Comment popover (Save); the text REPEAT5000 means 5,000 characters of 'abcdefghi '.",
   "reloadFromExport": "open the stored snapshot `name` again as the document, `via` paste (the Paste area, markup and CSS fields) or upload (the file chooser with the files), after Discard edits if asked.",
   "measureAt": "for each width in widths set the host width and compare the computed `prop` of `sel` in the preview with the expected string (hand-written).",
   "view": "as before: Desktop, Tablet or Phone.",
   "rotate": "as before: the Rotate button."
  },
  "asserts": {
   "insertBarOrder": "P5. In the quick bar (the Editor controls group) the buttons named `names` come directly after the button `after`, in that order.",
   "menuItemsOrder": "P5. The open menu of `button` has exactly the items `names`, in order.",
   "disabledWithReason": "P5. The button `name` is disabled (aria-disabled or disabled) and its tooltip (title or aria-description) contains `contains`.",
   "insertBarFits": "P1. At the host width the quick bar's controls are all inside the card (0.5 px), no control is clipped and the bar does not scroll sideways.",
   "placing": "P5. The editor [data-stage] carries [data-placing] (active true) or not.",
   "insertLine": "P1. [data-insert-line] is present with data-active equal to `active`; for an active line data-zone equals the zone just hovered.",
   "statusContains": "P5. The status line text contains `text`.",
   "exportEqualsOriginal": "P2. Every exported file equals the original source byte for byte.",
   "insertedVisible": "P1. At each width the element `sel` in the preview is at least minSize wide and high and lies inside the page horizontally.",
   "noOverflowX": "As before (P1), at each width in widths.",
   "exportsEqual": "As before.",
   "previewText": "P2. The textContent of `sel` in the preview equals `equals` exactly.",
   "exportText": "P2. After parsing the downloaded `file` in Chromium the textContent of `sel` equals `equals` exactly.",
   "exportParse": "P2. The downloaded `file` is parsed in Chromium: the element count differs from the original's by newElements (0 means none), no more script elements than the original, newComments more comment nodes than the original when given, textOf maps selectors to exact textContent, and with wellFormed an SVG parses as image/svg+xml with no parsererror.",
   "textEditor": "P1. [data-text-editor] is visible, its box lies within tol of the box of `sel` in the preview (every edge), and its value equals `value`.",
   "textEditorOpen": "P5. [data-text-editor] is visible (open true) or absent.",
   "gone": "P2. `sel` no longer matches in the preview.",
   "present": "P2. `sel` matches in the preview.",
   "selectedIs": "P5. The selected element in the preview is the one matching `sel`.",
   "exportCommentCount": "P2. In the downloaded (or snapshot) `file` the number of comments starting ' NOTE FOR AI' is `comments` and of header comments (the locked header text) is `headers`.",
   "buttonDisabled": "as before.",
   "commentPopover": "P5. The comment popover is open (open true); its text area has the accessible name `field` and, when given, the value `value`; its buttons are exactly `buttons`.",
   "exportNotes": "P2. In the parsed export the comment directly before each `sel` equals ' NOTE FOR AI: ' + text + ' '; the page note (when given) equals ' NOTE FOR AI (whole page): ' + pageNote + ' ' and sits right after the header; the header count equals headers and it is directly after the DOCTYPE (headerAfter doctype) or the first node (start); the number of NOTE comments equals the notes given plus the page note.",
   "pin": "P1. [data-pin][data-n=n] is visible, outside the preview iframe's document, and its centre lies within tol of the top-left corner of `sel`'s box (window points, iframe scale and device frame applied).",
   "iframeClean": "P5. The preview document contains no element with a data-pin attribute and no element that is not in the original document or created by an edit.",
   "exportLacks": "as before.",
   "notesList": "P5. The Notes popover is open (it is opened when open is not given); its first row is the page row (text equals pageRow, or the Add row); the other rows in order have the pin number n, the element's label (as the path labels) and the text; each row has Edit and Delete.",
   "checkboxState": "P5. The checkbox `name` is checked and disabled as stated.",
   "codeViewEquals": "P2. The Updated code view's text of every file equals the stored snapshot.",
   "equalsListWithout": "P2. The snapshot equals the export of the same edit list with every note edit left out, computed by the vendored engine in a scratch page.",
   "notesReadBack": "P2. Each note's comment text read back in Chromium equals the typed text with the stated neutralising rule applied by the spec's own reference function (every run of two or more hyphens gets a space between each pair), nothing else changed.",
   "review": "as before.",
   "uniqueNames": "P5. Each name in names is the accessible name of exactly one visible control.",
   "focusOn": "as before.",
   "popover": "as before.",
   "newTouchTargets": "P1. Every visible control named in `within` (and every menu item or button inside an open popover) is at least `min` px high and wide.",
   "popoverFits": "P1. The open popover named `name` lies inside the window (0.5 px) and no control in it is clipped.",
   "pinHit": "P1. The pin numbered n has a hit area at least `min` px high and wide.",
   "menuFits": "as before.",
   "css": "as before."
  }
