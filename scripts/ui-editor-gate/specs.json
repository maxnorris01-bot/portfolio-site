{
 "version": 1,
 "vocabulary": {
  "steps": {
   "load": "choose the sample in the Sample picker (value = id) and wait until the preview is ready",
   "view": "click the Desktop, Tablet or Phone button",
   "click": "a real mouse click on an element of the preview (found by a CSS selector inside the iframe): at \"center\", or at \"inset\" = 12 px in from its top-left corner (to hit the element itself, not its child)",
   "clickBlank": "a real click on the empty page area under the content, 8 px above the bottom edge of the preview",
   "drag": "pointer down at the element centre (handle null) or at the centre of the named resize handle, move in steps of about 4 px by (dx, dy) CSS px, pointer up",
   "type": "click the labelled panel field, select its text, type the text and press Enter",
   "uncheck": "click the labelled checkbox (it must be checked)",
   "button": "click the button with this accessible name",
   "selectFile": "choose a file in the File picker",
   "snapshot": "record the preview (all widths) and the export under a name, for later comparison"
  },
  "asserts": {
   "measure": "P1. Measure q (left, top, width, height, fontSize) of sel in the preview at width \"at\" (a number, or \"current\"). Modes: abs (equals value), delta (before + value), same (equals before), eqBefore (equals before(of, q)). Within tol. \"before\" is measured right after load.",
   "order": "P1. After the action, q of \"first\" is less than q of \"second\" at width \"at\"",
   "selection": "P1. The host [data-selection] box equals the box of the element in the preview, within tol",
   "field": "P5. The text of the labelled field equals value (numeric within tol when tol > 0)",
   "dot": "P5. The row [data-field=field] has (on) or has not a [data-dot]",
   "review": "P5. The button \"Review unlinked (N)\" has this N",
   "reviewList": "P5. The Review list has n items and the text of the first item contains every string",
   "reviewJump": "P5. Click the list item at index: it selects that element",
   "undo": "P5. The Undo button is enabled or not",
   "redo": "P5. The Redo button is enabled or not",
   "message": "P5. The \"Edit result\" region contains the text (case-insensitive)",
   "selected": "P5. [data-selected-label] contains the text",
   "noSelection": "P5. There is no [data-selection]",
   "env": "P5. [data-env] reads the text",
   "viewPressed": "P5. The named view button has aria-pressed=true",
   "iframeWidth": "P5. The preview iframe is this many CSS px wide",
   "checkbox": "P5. The labelled checkbox exists with this checked (and disabled) state",
   "tabletSentence": "P5. A visible sentence containing the text",
   "noHandles": "P5. No [data-handle] is present or enabled",
   "fieldDisabled": "P5. The labelled field is disabled",
   "buttonDisabled": "P5. The named button is disabled or not",
   "copy": "P5. Click Copy code; the clipboard text equals the export of the file",
   "status": "P5. The status region contains the text",
   "downloadName": "P5. Click Download for the chosen file; the saved file name equals name"
  },
  "baseline": "Measured on the preview right after load, before any step. A mismatch fails the spec as a setup error (it means the sample changed).",
  "p3": "target = the element the action edits (excluded); class and against as in docs/ui-editor-gate-rules.md section 2",
  "p4": "files = the files allowed to change, with the most changed lines of each; every other file must be byte-identical. permutation = a reorder must be a pure permutation of whole lines. sameAs = the export is byte-identical to a named snapshot"
 },
 "hostViewport": {
  "width": 1920,
  "height": 1080
 },
 "previewHeight": 800,
 "outcomes": [
  "PASS",
  "REFUSED",
  "FAIL"
 ],
 "specs": [
