{
 "version": 1,
 "vocabulary": {
  "steps": {
   "visit": "open the page with a fresh load and nothing opened (the host window is spec.host, else hostViewport)",
   "openCard": "click the gallery card of this sample (a real mouse click) and wait until the preview holds marker",
   "clickCard": "click the gallery card of this sample (it may open a confirmation instead of loading)",
   "waitMarker": "wait until the preview iframe holds the selector",
   "host": "resize the host window",
   "view / click / drag / type / button": "as in specs.json (drag moves the real mouse by dx, dy SCREEN px)"
  },
  "asserts": {
   "barButtons": "P6. The visible buttons of the group \"Editor controls\" are exactly names (with includes: at least these)",
   "absent": "P6. None of the listed controls (by role+name, selector or text) is visible or focusable (not in the DOM counts)",
   "present": "P5. Every listed control is visible",
   "cards": "P5. [data-gallery] holds exactly n [data-sample-card] with these titles, a non-empty description, and a miniature iframe whose sandbox has no allow-scripts, whose iframe box is non-zero, whose offsetWidth is minWidth (the sample at its real width) and whose document body has rendered children and a marker element with a non-zero box",
   "markerIn": "P5. The preview iframe does (has true) or does not contain the selector",
   "miniFidelity": "P1. Before opening: miniature iframe M of the sample's card, scale s = M screen width / M offsetWidth, marker box in M (CSS px). Then open the sample: marker box R in the real preview at Desktop. For left, top, width, height: |M x s - R x s| <= tol",
   "device": "P1. Measured: the iframe offsetWidth/offsetHeight (iframeH null: not checked); the transform matrix scale a of [data-device-scale] (scale = number within scaleTol, or scaleBelow: a < the number); [data-device-frame] present with data-device = kind and data-orientation for phone and tablet, absent for desktop; the horizontal centre of the frame (the iframe for desktop) within centredTol px of the centre of [data-stage-area]",
   "measureScaled": "P1. Like measure with mode delta, but the wanted change is screen / scale CSS px, scale read from the matrix of [data-device-scale] just before the drag",
   "handles": "P5. Exactly n [data-handle] elements",
   "noteText": "P5. [data-device-note] reads exactly this text",
   "textAbsent": "P5. The text is not in the visible page text",
   "chips": "P5. ul.chip-list.page-chips holds exactly these li.chip texts in this order",
   "ledeReach": "P1. The right edge of the page header's intro paragraph (.page-lede) is within tol px of the right edge of the content box of the first main .page-container",
   "columns": "P1. For each list (how: the \"What is measured\" list; limits; credits; all ul.ue-list in that order): the number of distinct item left edges (rounded to 2 px) is at least min, or exactly exact",
   "lineLength": "P1. Over every item of the three lists with at least two rendered lines: the mean length in characters of its lines except the last (text of each line box, from Range client rects) is between min and max"
  }
 },
 "hostViewport": {
  "width": 1920,
  "height": 1080
 },
 "previewHeight": 800,
 "outcomes": [
  "PASS",
  "FAIL"
 ],
 "specs": [
